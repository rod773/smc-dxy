//@version=6
indicator('SMT DXY Forex', overlay = true, max_lines_count = 500, max_labels_count = 500)

// ─── Inputs ──────────────────────────────────────────────────────────────────
showDXY = input.bool(true, 'Show DXY Panel')
showLabels = input.bool(true, 'Show Divergence Labels')
showLines = input.bool(true, 'Show Swing Point Lines')
pivotLen = input.int(5, 'Pivot Length', minval = 1)

// ─── Synthetic DXY from underlying forex pairs ──────────────────────────────
// Calibrated against real TVC:DXY to match exact values across all timeframes.
// Weights: EUR 57.6%, JPY 13.6%, GBP 11.9%, CAD 9.1%, SEK 4.2%, CHF 3.6%
// DXY = 50.14348112 × EURUSD^(-0.576) × USDJPY^(0.136) × GBPUSD^(-0.119)
//       × USDCAD^(0.091) × USDSEK^(0.042) × USDCHF^(0.036)

eur = request.security('FX:EURUSD', timeframe.period, close)
jpy = request.security('FX:USDJPY', timeframe.period, close)
gbp = request.security('FX:GBPUSD', timeframe.period, close)
cad = request.security('FX:USDCAD', timeframe.period, close)
sek = request.security('FX:USDSEK', timeframe.period, close)
chf = request.security('FX:USDCHF', timeframe.period, close)

calcRaw(e, j, g, c, s, h) =>
    50.14348112 * math.pow(e, -0.576) * math.pow(j, 0.136) * math.pow(g, -0.119)
                 * math.pow(c, 0.091) * math.pow(s, 0.042) * math.pow(h, 0.036)

realDxy = request.security('TVC:DXY', timeframe.period, close)
rawDxy = calcRaw(eur, jpy, gbp, cad, sek, chf)
var float calRatio = na
if not na(realDxy) and not na(rawDxy) and rawDxy != 0
    r = realDxy / rawDxy
    calRatio := na(calRatio) ? r : calRatio + 0.1 * (r - calRatio)

var float dxyHigh = na
var float dxyLow = na
var float dxyClose = na

dxyClose := na(calRatio) ? rawDxy : rawDxy * calRatio
dxyHigh := dxyClose
dxyLow := dxyClose

// ─── Swing Points ─────────────────────────────────────────────────────────────
isSwingHigh(src, l) =>
    na(src[l]) ? false : src == ta.highest(src, l * 2 + 1)
isSwingLow(src, l) =>
    na(src[l]) ? false : src == ta.lowest(src, l * 2 + 1)

swingHigh = isSwingHigh(high, pivotLen)
swingLow = isSwingLow(low, pivotLen)
dxySwingHigh = isSwingHigh(dxyHigh, pivotLen)
dxySwingLow = isSwingLow(dxyLow, pivotLen)

// ─── Store last two swing points for comparison ───────────────────────────────
var float lastHighPrice = na
var float lastLowPrice = na
var int lastHighBar = na
var int lastLowBar = na
var float prevHighPrice = na
var float prevLowPrice = na
var int prevHighBar = na
var int prevLowBar = na

var float lastDxyHigh = na
var float lastDxyLow = na
var int lastDxyHighBar = na
var int lastDxyLowBar = na
var float prevDxyHigh = na
var float prevDxyLow = na
var int prevDxyHighBar = na
var int prevDxyLowBar = na

if swingHigh
    prevHighPrice := lastHighPrice
    prevHighBar := lastHighBar
    lastHighPrice := high
    lastHighBar := bar_index

if swingLow
    prevLowPrice := lastLowPrice
    prevLowBar := lastLowBar
    lastLowPrice := low
    lastLowBar := bar_index

if dxySwingHigh
    prevDxyHigh := lastDxyHigh
    prevDxyHighBar := lastDxyHighBar
    lastDxyHigh := dxyHigh
    lastDxyHighBar := bar_index

if dxySwingLow
    prevDxyLow := lastDxyLow
    prevDxyLowBar := lastDxyLowBar
    lastDxyLow := dxyLow
    lastDxyLowBar := bar_index

// ─── Divergence Detection ─────────────────────────────────────────────────────
bearishSMT = na(prevHighPrice) or na(prevDxyHigh) ? false : lastHighPrice > prevHighPrice and lastDxyHigh < prevDxyHigh
bullishSMT = na(prevLowPrice) or na(prevDxyLow) ? false : lastLowPrice < prevLowPrice and lastDxyLow > prevDxyLow
hiddenBearish = na(prevHighPrice) or na(prevDxyHigh) ? false : lastHighPrice < prevHighPrice and lastDxyHigh > prevDxyHigh
hiddenBullish = na(prevLowPrice) or na(prevDxyLow) ? false : lastLowPrice > prevLowPrice and lastDxyLow < prevDxyLow

// ─── Plotting ─────────────────────────────────────────────────────────────────
if showLines and bearishSMT and not na(prevHighPrice) and not na(prevDxyHigh)
    line.new(prevHighBar, prevHighPrice, lastHighBar, lastHighPrice, color = color.red, width = 1, style = line.style_solid)
    line.new(prevDxyHighBar, prevDxyHigh, lastDxyHighBar, lastDxyHigh, color = color.green, width = 1, style = line.style_dashed)

if showLines and bullishSMT and not na(prevLowPrice) and not na(prevDxyLow)
    line.new(prevLowBar, prevLowPrice, lastLowBar, lastLowPrice, color = color.green, width = 1, style = line.style_solid)
    line.new(prevDxyLowBar, prevDxyLow, lastDxyLowBar, lastDxyLow, color = color.red, width = 1, style = line.style_dashed)

if showLabels and bearishSMT
    label.new(lastHighBar, high, 'SMT\nBearish', style = label.style_label_down, color = color.maroon, textcolor = color.white, size = size.small)
if showLabels and bullishSMT
    label.new(lastLowBar, low, 'SMT\nBullish', style = label.style_label_up, color = color.green, textcolor = color.white, size = size.small)

// ─── Dashboard ──────────────────────────────────────────────────────────────────
var table dxyTable = table.new(position.bottom_right, 2, 4, bgcolor = color.new(color.black, 80), border_width = 1, border_color = color.gray)
if showDXY
    dxyChange = (dxyClose - dxyClose[1]) / dxyClose[1] * 100
    dxyColor = dxyChange >= 0 ? color.green : color.red
    table.cell(dxyTable, 0, 0, 'fDXY', text_color = color.white, text_size = size.small)
    table.cell(dxyTable, 1, 0, str.tostring(dxyClose, format.mintick), text_color = dxyColor, text_size = size.small)
    table.cell(dxyTable, 0, 1, 'Chg %', text_color = color.gray, text_size = size.small)
    table.cell(dxyTable, 1, 1, str.tostring(dxyChange, '#.##') + '%', text_color = dxyColor, text_size = size.small)
else
    table.clear(dxyTable, 0, 0, 1, 3)

// ─── Alerts ───────────────────────────────────────────────────────────────────
alertcondition(bearishSMT, title = 'Bearish SMT Divergence', message = 'Bearish SMT divergence detected on {{ticker}} vs fDXY')
alertcondition(bullishSMT, title = 'Bullish SMT Divergence', message = 'Bullish SMT divergence detected on {{ticker}} vs fDXY')
