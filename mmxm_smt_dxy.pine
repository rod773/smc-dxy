// 6a. MMMM ICT Alerts
Alert.AlertSender(MitigationAlert_Bull, MMXM_Bull, AlertName, 'Bullish', 'Order Block Signal', 'Full', Frequncy, UTC, 'Off', 'Alert Demand Mitigation in MMXM ICT Setup', open, high, low, close, 0, 0, 0, 0, 0)
Alert.AlertSender(MitigationAlert_Bear, MMXM_Bear, AlertName, 'Bearish', 'Order Block Signal', 'Full', Frequncy, UTC, 'Off', 'Alert Supply Mitigation in MMXM ICT Setup', open, high, low, close, 0, 0, 0, 0, 0)

// 6b. Combined SMT DXY Alerts
alertcondition(smtBearish, title="Bearish SMT Divergence", message="Bearish SMT divergence detected on {{ticker}} vs DXY")
alertcondition(smtBullish, title="Bullish SMT Divergence", message="Bullish SMT divergence detected on {{ticker}} vs DXY")
